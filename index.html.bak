    addBoxObstacle(12, 1.3, 35, 6, 2.6, 1.4, crateBlueMat);
    addBoxObstacle(0, 0.65, 31, 7, 1.3, 1.2, wallMat); // Low sandbag/concrete barrier
    addBoxObstacle(-22, 2.2, 38, 3, 4.4, 8, wallMat);
