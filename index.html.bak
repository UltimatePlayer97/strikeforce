<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>STRIKEFORCE 6v6 — Tactical FPS</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />

  <!-- Import Map for Three.js & Addons via esm.sh -->
  <script type="importmap">
    {
      "imports": {
        "three": "https://esm.sh/three@0.160.0",
        "three/addons/": "https://esm.sh/three@0.160.0/examples/jsm/",
        "jszip": "https://esm.sh/jszip@3.10.1"
      }
    }
  </script>

  <style>
    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
    }
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: #090d16;
      font-family: 'Inter', sans-serif;
      color: #f8fafc;
    }
    #game-canvas {
      display: block;
      width: 100vw;
      height: 100vh;
    }
    .mono {
      font-family: 'JetBrains Mono', monospace;
    }
    input, select {
      user-select: text;
      -webkit-user-select: text;
    }
    .glass-hud {
      background: rgba(10, 15, 28, 0.72);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(148, 163, 184, 0.18);
    }
    .damage-vignette {
      pointer-events: none;
      background: radial-gradient(circle at center, transparent 52%, rgba(220, 38, 38, 0.65) 100%);
      opacity: 0;
      transition: opacity 0.15s ease-out;
    }
    @keyframes pulseSubtle {
      0%, 100% { opacity: 0.9; }
      50% { opacity: 0.45; }
    }
    .animate-pulse-subtle {
      animation: pulseSubtle 2s infinite ease-in-out;
    }
  </style>
</head>
<body>
  <!-- WebGL Viewport -->
  <canvas id="game-canvas"></canvas>

  <!-- Damage & Low-HP Screen Vignette -->
  <div id="damage-vignette" class="damage-vignette fixed inset-0 z-10"></div>

  <!-- Scope / ADS Subtle Vignette -->
  <div id="ads-vignette" class="pointer-events-none fixed inset-0 z-10 opacity-0 transition-opacity duration-150"
       style="background: radial-gradient(circle at center, transparent 62%, rgba(4, 7, 15, 0.58) 100%);"></div>

  <!-- Sniper Scope Overlay -->
  <div id="scope-overlay" class="pointer-events-none fixed inset-0 opacity-0 transition-opacity duration-100"
       style="z-index:15; background: radial-gradient(circle at center, transparent 0, transparent 37vmin, #000 37.4vmin);">
    <div style="position:absolute;left:50%;top:50%;width:74vmin;height:1px;transform:translate(-50%,-50%);background:rgba(0,0,0,0.85);"></div>
    <div style="position:absolute;left:50%;top:50%;width:1px;height:74vmin;transform:translate(-50%,-50%);background:rgba(0,0,0,0.85);"></div>
    <div style="position:absolute;left:50%;top:50%;width:5px;height:5px;border-radius:50%;transform:translate(-50%,-50%);background:#ef4444;box-shadow:0 0 4px #ef4444;"></div>
  </div>

  <!-- Active Combat HUD -->
  <div id="hud-layer" class="pointer-events-none fixed inset-0 z-20 hidden">
    <div id="spawn-protection-badge" class="absolute left-1/2 top-[18%] z-20 -translate-x-1/2 hidden px-4 py-1.5 rounded-full bg-cyan-400/15 border border-cyan-300/35 text-[10px] font-extrabold tracking-[0.18em] text-cyan-200 shadow-lg shadow-cyan-500/10 uppercase">
      SPAWN PROTECTION <span id="spawn-protection-time" class="mono text-white">3.0</span>
    </div>
    <div id="damage-direction" class="absolute left-1/2 top-1/2 z-20 h-28 w-28 -translate-x-1/2 -translate-y-1/2 opacity-0 transition-opacity duration-100">
      <div id="damage-direction-spin" class="absolute inset-0" style="transform: rotate(0deg);">
        <div class="absolute left-1/2 top-0 h-0 w-0 -translate-x-1/2 border-l-[13px] border-r-[13px] border-b-[26px] border-l-transparent border-r-transparent border-b-red-400"></div>
      </div>
    </div>
    <!-- Top-Left: Tactical 2D Radar Minimap -->
    <div class="absolute top-4 left-4 flex flex-col gap-2">
      <div class="glass-hud rounded-xl p-2 shadow-2xl">
        <div class="flex items-center justify-between px-1 pb-1 text-[10px] font-bold tracking-wider text-slate-300 uppercase">
          <span>TACTICAL RADAR</span>
          <span id="map-name-label" class="text-slate-500 pl-2">COMPOUND</span>
          <span id="zone-label" class="text-sky-400">COURTYARD</span>
        </div>
        <canvas id="radar-canvas" width="168" height="168" class="rounded-lg bg-slate-950/90 border border-slate-700/60"></canvas>
      </div>
      <div id="net-badge" class="hidden glass-hud rounded-lg px-2 py-1 text-[10px] font-bold tracking-wider text-emerald-300 mono"></div>
    </div>

    <!-- Top-Center: 6v6 Scoreboard Header & Alive Status Pips -->
    <div class="absolute top-4 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1.5">
      <div class="glass-hud rounded-xl px-5 py-2 flex items-center gap-5 shadow-2xl">
        <!-- Alpha Team -->
        <div class="flex items-center gap-3">
          <div class="text-right">
            <div class="text-[10px] font-bold tracking-widest text-blue-400">ALPHA</div>
            <div id="alpha-pips" class="flex gap-1 mt-0.5"></div>
          </div>
          <div id="alpha-score" class="mono text-2xl font-extrabold text-blue-400">0</div>
        </div>

        <!-- Match Clock / Target -->
        <div class="px-3 py-1 rounded-lg bg-slate-900/90 border border-slate-700/60 text-center">
          <div class="text-[9px] font-semibold tracking-widest text-slate-400">FIRST TO 30</div>
          <div id="match-timer" class="mono text-sm font-bold text-slate-100">10:00</div>
        </div>

        <!-- Bravo Team -->
        <div class="flex items-center gap-3">
          <div id="bravo-score" class="mono text-2xl font-extrabold text-red-400">0</div>
          <div class="text-left">
            <div class="text-[10px] font-bold tracking-widest text-red-400">BRAVO</div>
            <div id="bravo-pips" class="flex gap-1 mt-0.5"></div>
          </div>
        </div>
      </div>

      <!-- Round / Status Toast -->
      <div id="hud-toast" class="hidden px-4 py-1 rounded-full bg-amber-500/20 border border-amber-400/50 text-amber-200 text-xs font-bold tracking-wider uppercase shadow-lg"></div>
    </div>

    <!-- Top-Right: Live Killfeed -->
    <div id="killfeed" class="absolute top-4 right-4 flex flex-col items-end gap-1.5 w-72"></div>

    <!-- Center: Dynamic Crosshair & Hitmarker -->
    <div id="crosshair-container" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 flex items-center justify-center">
      <!-- Center Dot -->
      <div id="ch-dot" class="w-1 h-1 rounded-full bg-emerald-300 shadow-[0_0_4px_#000]"></div>
      <!-- Top/Bottom/Left/Right Ticks -->
      <div id="ch-top" class="absolute w-[2px] h-2.5 bg-emerald-300 shadow-[0_0_3px_#000]" style="transform: translateY(-10px);"></div>
      <div id="ch-bottom" class="absolute w-[2px] h-2.5 bg-emerald-300 shadow-[0_0_3px_#000]" style="transform: translateY(10px);"></div>
      <div id="ch-left" class="absolute h-[2px] w-2.5 bg-emerald-300 shadow-[0_0_3px_#000]" style="transform: translateX(-10px);"></div>
      <div id="ch-right" class="absolute h-[2px] w-2.5 bg-emerald-300 shadow-[0_0_3px_#000]" style="transform: translateX(10px);"></div>

    </div>

    <!-- Hitmarker X (own layer: stays visible in ADS / scope) -->
    <div id="hitmarker-wrap" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 flex items-center justify-center pointer-events-none">
      <svg id="hitmarker" class="w-7 h-7 opacity-0 transition-opacity duration-75" viewBox="0 0 28 28">
        <line x1="5" y1="5" x2="10" y2="10" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
        <line x1="23" y1="5" x2="18" y2="10" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
        <line x1="5" y1="23" x2="10" y2="18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
        <line x1="23" y1="23" x2="18" y2="18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
      </svg>
    </div>

    <!-- Human Player 3rd-Person Ragdoll Death Cam Banner -->
    <div id="death-cam-overlay" class="hidden absolute inset-x-0 bottom-28 flex flex-col items-center justify-center">
      <div class="glass-hud border-red-500/50 rounded-2xl px-7 py-4 text-center shadow-2xl">
        <div class="text-xs font-extrabold tracking-widest text-red-400 uppercase">OPERATOR KIA — RAGDOLL CAM</div>
        <div id="death-killer-text" class="text-lg font-bold text-white mt-0.5">Eliminated by BRAVO-1</div>
        <div class="mt-2 flex items-center justify-center gap-2">
          <span id="respawn-base-text" class="text-xs text-slate-300">Respawning at Alpha Base in</span>
          <span id="death-timer-text" class="mono text-base font-extrabold text-amber-400">5.0s</span>
        </div>
      </div>
    </div>

    <!-- Bottom-Left: Health & Stance Status -->
    <div class="absolute bottom-5 left-5 glass-hud rounded-2xl p-4 w-64 shadow-2xl">
      <div class="flex items-baseline justify-between">
        <div class="flex items-baseline gap-2">
          <span id="hp-value" class="mono text-3xl font-extrabold text-emerald-400">100</span>
          <span class="text-xs font-bold tracking-wider text-slate-400">HP</span>
        </div>
        <span id="stance-badge" class="px-2 py-0.5 rounded bg-blue-500/20 border border-blue-400/30 text-[10px] font-bold text-blue-300 uppercase">
          ALPHA-LEAD
        </span>
      </div>
      <div class="w-full h-2.5 bg-slate-900 rounded-full overflow-hidden mt-2 border border-slate-700/70">
        <div id="hp-bar" class="h-full bg-gradient-to-r from-emerald-500 to-teal-400 transition-all duration-150" style="width: 100%;"></div>
      </div>
      <div class="mt-2 flex items-center justify-between text-[11px] text-slate-400">
        <span>[TAB] Scoreboard</span>
        <span>[ESC] Armory / Pause</span>
      </div>
    </div>

    <!-- Bottom-Right: Weapon & Ammo Counter -->
    <div class="absolute bottom-5 right-5 glass-hud rounded-2xl p-4 w-64 text-right shadow-2xl">
      <div id="weapon-name-hud" class="text-xs font-extrabold tracking-widest text-sky-400 uppercase">M4A1 CARBINE</div>
      <div class="mt-1 flex items-baseline justify-end gap-1.5">
        <span id="ammo-mag" class="mono text-3xl font-extrabold text-white">30</span>
        <span class="mono text-base text-slate-400">/</span>
        <span id="ammo-reserve" class="mono text-lg font-bold text-slate-300">180</span>
      </div>
      <div id="reload-bar-wrap" class="hidden w-full h-1.5 bg-slate-900 rounded-full overflow-hidden mt-2">
        <div id="reload-bar" class="h-full bg-amber-400" style="width: 0%;"></div>
      </div>
      <div id="ammo-hint" class="mt-1.5 text-[11px] text-slate-400">[LMB] Fire &bull; [RMB] ADS &bull; [R] Reload</div>
      <div id="throwable-hud" class="mt-2 flex items-center justify-end gap-2" aria-label="Throwable inventory">
        <div class="flex items-center gap-1 rounded-md bg-slate-900/80 border border-slate-700/70 px-2 py-1">
          <svg class="h-4 w-4 text-amber-300" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 8c-2.8 1.3-4 3.5-4 6.2A7.8 7.8 0 0 0 11.8 22h.4A7.8 7.8 0 0 0 20 14.2c0-2.7-1.2-4.9-4-6.2V5h2V2H6v3h2v3zm4-3h0l.8-2h-1.6L12 5z"/></svg>
          <span id="grenade-count" class="mono text-xs font-bold text-white">1</span>
          <span class="text-[9px] font-bold text-slate-400">[G]</span>
        </div>
        <div class="flex items-center gap-1 rounded-md bg-slate-900/80 border border-slate-700/70 px-2 py-1">
          <svg class="h-4 w-4 text-slate-200" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 3h10v3l2 3v10a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V9l2-3V3zm2 2v2h6V5H9zm1 7h4v2h-4v-2z"/></svg>
          <span id="smoke-count" class="mono text-xs font-bold text-white">1</span>
          <span class="text-[9px] font-bold text-slate-400">[F]</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Live 6v6 TAB Scoreboard Overlay -->
  <div id="scoreboard-overlay" class="hidden pointer-events-none fixed inset-0 z-30 flex items-center justify-center bg-slate-950/55 backdrop-blur-sm p-4">
    <div class="glass-hud rounded-2xl w-full max-w-4xl p-6 shadow-2xl border border-slate-600/40">
      <div class="flex items-center justify-between border-b border-slate-700/70 pb-3 mb-4">
        <div>
          <h2 class="text-xl font-extrabold tracking-wider text-white">STRIKEFORCE 6v6 — TACTICAL ROSTER</h2>
          <p class="text-xs text-slate-400">Operation Iron Compound &bull; Team Deathmatch (30 Kills)</p>
        </div>
        <div class="mono text-sm font-bold text-slate-300">
          <span class="text-blue-400">ALPHA <span id="sb-alpha-score">0</span></span>
          <span class="mx-2 text-slate-500">VS</span>
          <span class="text-red-400">BRAVO <span id="sb-bravo-score">0</span></span>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Alpha Roster -->
        <div class="bg-blue-950/25 border border-blue-500/25 rounded-xl p-3">
          <div class="text-xs font-extrabold tracking-widest text-blue-400 uppercase mb-2 px-2">TEAM ALPHA (BLUE)</div>
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="text-slate-400 border-b border-slate-800">
                <th class="py-1.5 px-2">OPERATOR</th>
                <th class="py-1.5 px-2">STATUS</th>
                <th class="py-1.5 px-2 text-right">K</th>
                <th class="py-1.5 px-2 text-right">D</th>
              </tr>
            </thead>
            <tbody id="sb-alpha-body" class="divide-y divide-slate-800/60"></tbody>
          </table>
        </div>
        <!-- Bravo Roster -->
        <div class="bg-red-950/25 border border-red-500/25 rounded-xl p-3">
          <div class="text-xs font-extrabold tracking-widest text-red-400 uppercase mb-2 px-2">TEAM BRAVO (RED)</div>
          <table class="w-full text-left text-xs">
            <thead>
              <tr class="text-slate-400 border-b border-slate-800">
                <th class="py-1.5 px-2">OPERATOR</th>
                <th class="py-1.5 px-2">STATUS</th>
                <th class="py-1.5 px-2 text-right">K</th>
                <th class="py-1.5 px-2 text-right">D</th>
              </tr>
            </thead>
            <tbody id="sb-bravo-body" class="divide-y divide-slate-800/60"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Deploy / Pause / Armory Modal -->
  <div id="menu-overlay" class="fixed inset-0 z-40 flex bg-slate-950/80 backdrop-blur-md p-4 overflow-y-auto">
    <div class="glass-hud rounded-3xl w-full max-w-2xl p-6 sm:p-8 shadow-2xl border border-slate-600/40 m-auto">
      <div class="flex items-center justify-between">
        <div>
          <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-blue-500/20 border border-blue-400/30 text-[11px] font-bold tracking-wider text-blue-300 uppercase">
            <span>6v6 TACTICAL FPS</span>
            <span>&bull;</span>
            <span>VERLET RAGDOLLS + A* AI</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white mt-2">STRIKEFORCE 6v6</h1>
        </div>
        <div id="load-status-badge" class="px-3 py-1.5 rounded-xl bg-emerald-500/15 border border-emerald-400/30 text-xs font-semibold text-emerald-300">
          Systems Ready
        </div>
      </div>

      <p class="text-sm text-slate-300 mt-3 leading-relaxed">
        Lead <strong class="text-blue-400">Team Alpha (6)</strong> against <strong class="text-red-400">Team Bravo (6)</strong>. Maps rotate randomly between Compound, Shipment, Shoot House, Blast Town and Downtown after each full match. Features 11-node articulated Verlet ragdoll physics for both AI soldiers and your own 3rd-person death cam, plus tactical A* pathfinding.
      </p>

      <!-- Loadout / Class Select -->
      <div class="mt-5 bg-slate-900/80 border border-slate-700/70 rounded-2xl p-4">
        <div class="flex items-center justify-between gap-2">
          <div class="text-xs font-extrabold tracking-wider text-sky-400 uppercase">LOADOUT &bull; CLASS SELECT</div>
          <span id="loadout-note" class="text-[11px] font-semibold text-slate-400"></span>
        </div>
        <div id="loadout-grid" class="grid grid-cols-2 sm:grid-cols-5 gap-2 mt-3"></div>
        <p class="text-[10px] text-slate-500 mt-2">Swap any time. Instant inside your spawn zone, otherwise on next respawn. Bots run random classes.</p>
      </div>

      <!-- Settings & Custom Weapon Armory -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-5">
        <!-- Controls & Sensitivity -->
        <div class="bg-slate-900/80 border border-slate-700/70 rounded-2xl p-4 space-y-3">
          <div class="text-xs font-extrabold tracking-wider text-slate-300 uppercase">COMBAT SETTINGS</div>
          <div>
            <div class="flex justify-between text-xs text-slate-300 mb-1">
              <span>Mouse Sensitivity</span>
              <span id="sens-val" class="mono text-sky-400 font-bold">1.00</span>
            </div>
            <input id="sens-slider" type="range" min="0.2" max="2.5" step="0.05" value="1.0"
                   class="w-full accent-sky-400 cursor-pointer" />
          </div>
          <div>
            <div class="flex justify-between text-xs text-slate-300 mb-1">
              <span>ADS Sensitivity</span>
              <span id="ads-sens-val" class="mono text-sky-400 font-bold">1.00</span>
            </div>
            <input id="ads-sens-slider" type="range" min="0.2" max="1.5" step="0.05" value="1.0"
                   class="w-full accent-sky-400 cursor-pointer" />
          </div>
          <div>
            <div class="flex justify-between text-xs text-slate-300 mb-1">
              <span>Base FOV</span>
              <span id="fov-val" class="mono text-sky-400 font-bold">75</span>
            </div>
            <input id="fov-slider" type="range" min="60" max="100" step="1" value="75"
                   class="w-full accent-sky-400 cursor-pointer" />
          </div>
          <label class="flex items-center justify-between gap-3 rounded-lg bg-slate-800/50 border border-slate-700/70 px-2.5 py-2 text-xs text-slate-300 cursor-pointer">
            <span>Camera bob</span>
            <input id="camera-bob-toggle" type="checkbox" checked class="accent-sky-400 cursor-pointer" />
          </label>
          <div>
            <div class="flex justify-between text-xs text-slate-300 mb-1">
              <span>AI Tactical Skill</span>
            </div>
            <select id="ai-skill-select" class="w-full rounded-lg bg-slate-800 border border-slate-600 px-2.5 py-1.5 text-xs text-white font-semibold">
              <option value="RECRUIT">Recruit (Balanced)</option>
              <option value="VETERAN" selected>Veteran (Tactical Flanking)</option>
              <option value="ELITE">Elite (Sharp Reflexes)</option>
            </select>
          </div>
        </div>

        <!-- Custom Weapon Importer -->
        <div class="bg-slate-900/80 border border-slate-700/70 rounded-2xl p-4 flex flex-col justify-between">
          <div>
            <div class="text-xs font-extrabold tracking-wider text-amber-400 uppercase">ARMORY: WEAPON</div>
            <p class="text-[11px] text-slate-400 mt-1">
              Hot-swap a custom <code class="text-slate-200">.ZIP</code> (e.g. CW_M4A1_Custom.zip), <code class="text-slate-200">.OBJ</code>, or <code class="text-slate-200">.GLB</code> as the <strong class="text-slate-200">ASSAULT</strong> class rifle model.
            </p>
          </div>
          <div class="mt-3 flex flex-col gap-2">
            <select id="weapon-preset-select" class="w-full rounded-lg bg-slate-800 border border-slate-600 px-2.5 py-1.5 text-xs text-white font-semibold"></select>
            <label class="w-full cursor-pointer text-center py-2 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-600 text-xs font-bold text-slate-100 transition">
              <span>UPLOAD .ZIP / .OBJ / .GLB</span>
              <input id="weapon-file-input" type="file" accept=".zip,.obj,.glb,.gltf" class="hidden" />
            </label>
            <button id="reset-weapon-btn" type="button"
                    class="w-full py-1.5 px-3 rounded-xl bg-slate-800/60 hover:bg-slate-700/70 border border-slate-700 text-[11px] font-semibold text-slate-300 transition">
              Reset to Base M4A1
            </button>
          </div>
        </div>
      </div>

      <!-- Multiplayer (Cloudflare relay) -->
      <div class="mt-4 bg-slate-900/80 border border-slate-700/70 rounded-2xl p-4">
        <div class="flex items-center justify-between">
          <div class="text-xs font-extrabold tracking-wider text-emerald-400 uppercase">MULTIPLAYER &bull; P2P MESH + RELAY FALLBACK</div>
          <span id="mp-status" class="text-[11px] font-semibold text-slate-400">Offline</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mt-2">
          <input id="mp-relay" type="text" spellcheck="false" autocomplete="off" value="wss://strikeforce-relay.proxy-roblox.workers.dev" placeholder="wss://strikeforce-relay.proxy-roblox.workers.dev"
                 class="sm:col-span-2 w-full rounded-lg bg-slate-800 border border-slate-600 px-2.5 py-1.5 text-xs text-white mono disabled:opacity-50" />
          <input id="mp-name" type="text" maxlength="14" spellcheck="false" autocomplete="off" placeholder="Callsign"
                 class="w-full rounded-lg bg-slate-800 border border-slate-600 px-2.5 py-1.5 text-xs text-white font-semibold disabled:opacity-50" />
          <input id="mp-room" type="text" maxlength="12" spellcheck="false" autocomplete="off" placeholder="ROOM CODE"
                 class="w-full rounded-lg bg-slate-800 border border-slate-600 px-2.5 py-1.5 text-xs text-white mono uppercase disabled:opacity-50" />
          <select id="mp-team" class="w-full rounded-lg bg-slate-800 border border-slate-600 px-2.5 py-1.5 text-xs text-white font-semibold disabled:opacity-50">
            <option value="AUTO">Team: Auto-balance</option>
            <option value="ALPHA">Team: Alpha (Blue)</option>
            <option value="BRAVO">Team: Bravo (Red)</option>
          </select>
          <div class="flex gap-2">
            <button id="mp-new-btn" type="button" class="flex-1 py-1.5 rounded-lg bg-emerald-600/80 hover:bg-emerald-500 text-[11px] font-extrabold tracking-wider text-white uppercase transition">New Room</button>
            <button id="mp-join-btn" type="button" class="flex-1 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 border border-slate-500 text-[11px] font-extrabold tracking-wider text-white uppercase transition">Join</button>
          </div>
        </div>
        <div id="mp-connected" class="hidden mt-3">
          <div id="mp-roster" class="text-[11px] space-y-0.5 mono"></div>
          <div class="flex gap-2 mt-2">
            <button id="mp-copy-btn" type="button" class="flex-1 py-1.5 rounded-lg bg-slate-700 hover:bg-slate-600 border border-slate-500 text-[11px] font-bold text-white uppercase transition">Copy Invite Link</button>
            <button id="mp-leave-btn" type="button" class="flex-1 py-1.5 rounded-lg bg-red-600/70 hover:bg-red-500 text-[11px] font-bold text-white uppercase transition">Leave Room</button>
          </div>
        </div>
        <p class="text-[10px] text-slate-500 mt-2">Up to 12 humans (6v6). WebRTC mesh carries gameplay directly between players; Worker handles room signalling and fallback relay. Empty slots stay AI, run by room host.</p>
      </div>

      <!-- Keybinds Summary -->
      <div class="mt-4 bg-slate-900/60 border border-slate-800 rounded-xl px-4 py-2.5 flex flex-wrap items-center justify-between gap-2 text-[11px] text-slate-300">
        <span><strong class="text-white">WASD</strong> Move</span>
        <span><strong class="text-white">SHIFT</strong> Sprint</span>
        <span><strong class="text-white">SPACE</strong> Jump</span>
        <span><strong class="text-white">LMB</strong> Fire</span>
        <span><strong class="text-white">RMB</strong> ADS Zoom</span>
        <span><strong class="text-white">C</strong> Crouch</span>
        <span><strong class="text-white">G</strong> Grenade</span>
        <span><strong class="text-white">F</strong> Smoke</span>
        <span><strong class="text-white">R</strong> Reload</span>
        <span><strong class="text-white">TAB</strong> Roster</span>
      </div>

      <!-- Primary Deploy / Resume Action -->
      <button id="deploy-btn" type="button"
              class="mt-5 w-full py-3.5 rounded-2xl bg-gradient-to-r from-blue-600 to-sky-500 hover:from-blue-500 hover:to-sky-400 text-white font-extrabold text-sm tracking-wider uppercase shadow-lg shadow-blue-600/30 transition transform active:scale-[0.99] cursor-pointer">
        CLICK TO DEPLOY — ALPHA-LEAD
      </button>
    </div>
  </div>

  <!-- Main 3D Simulation, Verlet Ragdoll Physics, A* Pathfinding & Gameplay Engine -->
  <script id="embedded-m4a1" type="application/json">{"obj_gz":"","mtl":"newmtl vltor_cs_weapons-pricel\nKa 1 1 1\nKd 1 1 1\nKs 0.3 0.3 0.3\nNs 60\nillum 2\nmap_Kd textures/deniel_ironsights.png\n\nnewmtl vltor_cs_weapons-marks\nKa 1 1 1\nKd 1 1 1\nKs 0.3 0.3 0.3\nNs 60\nillum 2\n\nnewmtl vltor_weapons-m4\nKa 1 1 1\nKd 1 1 1\nKs 0.3 0.3 0.3\nNs 60\nillum 2\nmap_Kd textures/m4.png\n\nnewmtl vltor_cs_weapons-grip\nKa 1 1 1\nKd 1 1 1\nKs 0.3 0.3 0.3\nNs 60\nillum 2\nmap_Kd textures/zenith_grip.png\n\nnewmtl m4_muzzlebrake\nKa 1 1 1\nKd 1 1 1\nKs 0.3 0.3 0.3\nNs 60\nillum 2\nmap_Kd textures/m4_muzzlebrake.png\n\nnewmtl vltor_cs_weapons-magazine\nKa 1 1 1\nKd 1 1 1\nKs 0.3 0.3 0.3\nNs 60\nillum 2\nmap_Kd textures/pmag_sand.png\n\nnewmtl vltor_cs_weapons-m4\nKa 1 1 1\nKd 1 1 1\nKs 0.3 0.3 0.3\nNs 60\nillum 2\nmap_Kd textures/m4.png\n\nnewmtl kollimator_high\nKa 1 1 1\nKd 1 1 1\nKs 0.3 0.3 0.3\nNs 60\nillum 2\nmap_Kd textures/h1.png\n\nnewmtl optic_glass_round\nKa 1 1 1\nKd 0.05 0.05 0.05\nKs 0.3 0.3 0.3\nNs 60\nillum 2\nd 0.35\n\nnewmtl Suppressor\nKa 1 1 1\nKd 1 1 1\nKs 0.3 0.3 0.3\nNs 60\nillum 2\nmap_Kd textures/ebr_silencer.png\n\nnewmtl none\nKd 0.5 0.5 0.5\n","tex":{"m4.png":"data:image/jpeg;base64,","h1.png":"data:image/jpeg;base64,","deniel_ironsights.png":"data:image/jpeg;base64,","ebr_silencer.png":"data:image/jpeg;base64,","m4_muzzlebrake.png":"data:image/jpeg;base64,","pmag_sand.png":"data:image/jpeg;base64,","zenith_grip.png":"data:image/jpeg;base64,"}}</script>
  
  <script type="module">
    import * as THREE from 'three';
    import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
    import { OBJLoader } from 'three/addons/loaders/OBJLoader.js';
    import { MTLLoader } from 'three/addons/loaders/MTLLoader.js';
    import * as SkeletonUtils from 'three/addons/utils/SkeletonUtils.js';
    import { mergeGeometries } from 'three/addons/utils/BufferGeometryUtils.js';
    import JSZip from 'jszip';

    // =========================================================================
    // 1. PROCEDURAL WEB AUDIO SYNTHESIZER (Zero External Audio Dependencies)
    // =========================================================================
    class SoundFX {
      constructor() {
        this.ctx = null;
      }

      init() {
        if (!this.ctx) {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          if (AudioCtx) this.ctx = new AudioCtx();
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume().catch(() => {});
        }
      }

      playGunshot(isPlayer = true, distance = 0, kind = 'assault', pos = null) {
        if (!this.ctx) return;
        const now = this.ctx.currentTime;
        const prof = { assault: [1, 1], smg: [0.85, 1.3], lmg: [1.1, 0.8], shotgun: [1.3, 0.6], sniper: [1.45, 0.5] }[kind] || [1, 1];
        const spatialInfo = pos && !isPlayer ? this.spatial(pos, 70) : { pan: 0, gain: 1 };
        const atten = (isPlayer ? 0.32 : Math.min(0.24, spatialInfo.gain * 0.28) * prof[0]);
        if (atten <= 0.005) return;

        // White noise burst for propellant crack
        const bufferSize = Math.floor(this.ctx.sampleRate * 0.14);
        const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
          data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (this.ctx.sampleRate * 0.028));
        }

        const noise = this.ctx.createBufferSource();
        noise.buffer = buffer;

        const filter = this.ctx.createBiquadFilter();
        filter.type = 'bandpass';
        filter.frequency.setValueAtTime((isPlayer ? 1350 : 950) * prof[1], now);
        filter.Q.value = 0.85;

        const gain = this.ctx.createGain();
        gain.gain.setValueAtTime(atten, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.14);

        noise.connect(filter);
        filter.connect(gain);
        if (isPlayer) gain.connect(this.ctx.destination);
        else this.connectSpatial(gain, pos, 70);
        noise.start(now);

        // Low punch thump
        const osc = this.ctx.createOscillator();
        const oscGain = this.ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(160, now);
        osc.frequency.exponentialRampToValueAtTime(38, now + 0.09);
        oscGain.gain.setValueAtTime(atten * 0.8, now);
        oscGain.gain.exponentialRampToValueAtTime(0.001, now + 0.09);
        osc.connect(oscGain);
        oscGain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + 0.095);
      }

      playHitmarker(isHeadshot = false) {
        if (!this.ctx) return;
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = isHeadshot ? 'sine' : 'triangle';
        osc.frequency.setValueAtTime(isHeadshot ? 1950 : 1200, now);
        osc.frequency.exponentialRampToValueAtTime(isHeadshot ? 2600 : 750, now + 0.065);
        gain.gain.setValueAtTime(0.24, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.07);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + 0.075);
      }

      playReload() {
        if (!this.ctx) return;
        const now = this.ctx.currentTime;
        [0, 0.75, 1.35].forEach((offset, idx) => {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'square';
          osc.frequency.setValueAtTime(idx === 2 ? 780 : 480, now + offset);
          gain.gain.setValueAtTime(0.11, now + offset);
          gain.gain.exponentialRampToValueAtTime(0.001, now + offset + 0.06);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start(now + offset);
          osc.stop(now + offset + 0.065);
        });
      }

      spatial(pos, maxDistance) {
        if (!pos) return { pan: 0, gain: 1 };
        const dx = pos.x - humanPlayer.pos.x;
        const dz = pos.z - humanPlayer.pos.z;
        const dist = Math.hypot(dx, dz);
        const forward = { x: -Math.sin(humanPlayer.yaw), z: -Math.cos(humanPlayer.yaw) };
        const right = { x: Math.cos(humanPlayer.yaw), z: -Math.sin(humanPlayer.yaw) };
        const pan = dist > 0.01 ? THREE.MathUtils.clamp((dx * right.x + dz * right.z) / dist, -1, 1) : 0;
        const gain = Math.max(0, 1 - dist / maxDistance) ** 1.35;
        return { pan, gain };
      }

      connectSpatial(node, pos, maxDistance) {
        const s = this.spatial(pos, maxDistance);
        if (typeof StereoPannerNode !== 'undefined' && this.ctx && s.pan !== 0) {
          const panner = this.ctx.createStereoPanner();
          panner.pan.value = s.pan;
          node.connect(panner);
          panner.connect(this.ctx.destination);
          return s;
        }
        node.connect(this.ctx.destination);
        return s;
      }

      playFootstep(pos, intensity = 1) {
        if (!this.ctx) return;
        const s = this.spatial(pos, 42);
        if (s.gain <= 0.01) return;
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(85 + Math.random() * 25, now);
        osc.frequency.exponentialRampToValueAtTime(45 + Math.random() * 15, now + 0.085);
        gain.gain.setValueAtTime(0.055 * intensity * s.gain, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.09);
        osc.connect(gain);
        this.connectSpatial(gain, pos, 42);
        osc.start(now);
        osc.stop(now + 0.095);
      }

      playGrenadeBounce(pos, intensity = 1) {
        if (!this.ctx) return;
        const s = this.spatial(pos, 40);
        if (s.gain <= 0.01) return;
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'square';
        osc.frequency.setValueAtTime(210 + Math.random() * 55, now);
        gain.gain.setValueAtTime(0.085 * intensity * s.gain, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.055);
        osc.connect(gain);
        this.connectSpatial(gain, pos, 40);
        osc.start(now);
        osc.stop(now + 0.06);
      }

      playThrow(pos) {
        if (!this.ctx) return;
        const s = this.spatial(pos, 24);
        if (s.gain <= 0.01) return;
        const now = this.ctx.currentTime;
        const bufferSize = Math.floor(this.ctx.sampleRate * 0.08);
        const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) data[i] = (Math.random() * 2 - 1) * (1 - i / bufferSize);
        const src = this.ctx.createBufferSource();
        src.buffer = buffer;
        const filter = this.ctx.createBiquadFilter();
        filter.type = 'bandpass';
        filter.frequency.value = 1300;
        filter.Q.value = 1.5;
        const gain = this.ctx.createGain();
        gain.gain.setValueAtTime(0.08 * s.gain, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
        src.connect(filter);
        filter.connect(gain);
        this.connectSpatial(gain, pos, 24);
        src.start(now);
      }

      playSmokePop(pos) {
        if (!this.ctx) return;
        const s = this.spatial(pos, 34);
        if (s.gain <= 0.01) return;
        const now = this.ctx.currentTime;
        const bufferSize = Math.floor(this.ctx.sampleRate * 0.22);
        const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (this.ctx.sampleRate * 0.075));
        const src = this.ctx.createBufferSource();
        src.buffer = buffer;
        const filter = this.ctx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(1600, now);
        filter.frequency.exponentialRampToValueAtTime(300, now + 0.22);
        const gain = this.ctx.createGain();
        gain.gain.setValueAtTime(0.2 * s.gain, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);
        src.connect(filter);
        filter.connect(gain);
        this.connectSpatial(gain, pos, 34);
        src.start(now);
      }

      playExplosion(pos) {
        if (!this.ctx) return;
        const s = this.spatial(pos, 80);
        const boom = Math.max(0.02, s.gain);
        const now = this.ctx.currentTime;
        const bufferSize = Math.floor(this.ctx.sampleRate * 0.55);
        const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (this.ctx.sampleRate * 0.19));
        const noise = this.ctx.createBufferSource();
        noise.buffer = buffer;
        const low = this.ctx.createBiquadFilter();
        low.type = 'lowpass';
        low.frequency.setValueAtTime(650, now);
        low.frequency.exponentialRampToValueAtTime(110, now + 0.52);
        const gain = this.ctx.createGain();
        gain.gain.setValueAtTime(0.48 * boom, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.55);
        noise.connect(low);
        low.connect(gain);
        this.connectSpatial(gain, pos, 80);
        noise.start(now);

        const osc = this.ctx.createOscillator();
        const oscGain = this.ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(92, now);
        osc.frequency.exponentialRampToValueAtTime(31, now + 0.45);
        oscGain.gain.setValueAtTime(0.34 * boom, now);
        oscGain.gain.exponentialRampToValueAtTime(0.001, now + 0.48);
        osc.connect(oscGain);
        this.connectSpatial(oscGain, pos, 80);
        osc.start(now);
        osc.stop(now + 0.5);
      }

      playDamageTaken() {
        if (!this.ctx) return;
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(110, now);
        osc.frequency.exponentialRampToValueAtTime(42, now + 0.16);
        gain.gain.setValueAtTime(0.26, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.17);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + 0.18);
      }
    }

    const sfx = new SoundFX();

    // =========================================================================
    // 2. THREE.JS SCENE, RENDERER & LIGHTING SETUP
    // =========================================================================
    const canvas = document.getElementById('game-canvas');
    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      powerPreference: 'high-performance'
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.12;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x162235);
    scene.fog = new THREE.FogExp2(0x162235, 0.0075);

    const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.03, 260);
    scene.add(camera);

    // Tactical Daylight / Overcast Military Compound Lighting
    const hemiLight = new THREE.HemisphereLight(0xdbeafe, 0x334155, 0.95);
    hemiLight.position.set(0, 50, 0);
    scene.add(hemiLight);

    const sunLight = new THREE.DirectionalLight(0xfff7ed, 1.85);
    sunLight.position.set(38, 62, 28);
    sunLight.castShadow = true;
    sunLight.shadow.mapSize.width = 1024;
    sunLight.shadow.mapSize.height = 1024;
    sunLight.shadow.camera.near = 5;
    sunLight.shadow.camera.far = 165;
    const d = 62;
    sunLight.shadow.camera.left = -d;
    sunLight.shadow.camera.right = d;
    sunLight.shadow.camera.top = d;
    sunLight.shadow.camera.bottom = -d;
    sunLight.shadow.bias = -0.0005;
    scene.add(sunLight);

    // Team Base Accent Lights
    const alphaBaseLight = new THREE.PointLight(0x3b82f6, 3.2, 28);
    alphaBaseLight.position.set(0, 5.5, 40);
    scene.add(alphaBaseLight);

    const bravoBaseLight = new THREE.PointLight(0xef4444, 3.2, 28);
    bravoBaseLight.position.set(0, 5.5, -40);
    scene.add(bravoBaseLight);

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    // =========================================================================
    // 3. PROCEDURAL TEXTURES & 3D MILITARY COMPOUND MAP + COLLISION SYSTEM
    // =========================================================================
    function createGridTexture(baseHex, lineHex, repeat = 20) {
      const c = document.createElement('canvas');
      c.width = 256;
      c.height = 256;
      const ctx = c.getContext('2d');
      ctx.fillStyle = baseHex;
      ctx.fillRect(0, 0, 256, 256);
      ctx.strokeStyle = lineHex;
      ctx.lineWidth = 3;
      ctx.strokeRect(0, 0, 256, 256);
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(128, 0); ctx.lineTo(128, 256);
      ctx.moveTo(0, 128); ctx.lineTo(256, 128);
      ctx.stroke();
      // Subtle concrete speckle
      ctx.fillStyle = 'rgba(255,255,255,0.03)';
      for (let i = 0; i < 180; i++) {
        ctx.fillRect(Math.random() * 256, Math.random() * 256, 2, 2);
      }
      const tex = new THREE.CanvasTexture(c);
      tex.wrapS = THREE.RepeatWrapping;
      tex.wrapT = THREE.RepeatWrapping;
      tex.repeat.set(repeat, repeat);
      return tex;
    }

    const groundMat = new THREE.MeshStandardMaterial({
      map: createGridTexture('#2a3342', '#394559', 26),
      roughness: 0.88,
      metalness: 0.08
    });
    const wallMat = new THREE.MeshStandardMaterial({
      map: createGridTexture('#475569', '#334155', 3),
      roughness: 0.78,
      metalness: 0.12
    });
    const crateBlueMat = new THREE.MeshStandardMaterial({
      map: createGridTexture('#1d4ed8', '#1e3a8a', 1),
      roughness: 0.55,
      metalness: 0.35
    });
    const crateRedMat = new THREE.MeshStandardMaterial({
      map: createGridTexture('#b91c1c', '#7f1d1d', 1),
      roughness: 0.55,
      metalness: 0.35
    });
    const crateOliveMat = new THREE.MeshStandardMaterial({
      map: createGridTexture('#3f6212', '#365314', 1),
      roughness: 0.65,
      metalness: 0.25
    });
    const brickMat = new THREE.MeshStandardMaterial({
      map: createGridTexture('#7f3f35', '#4a241f', 5),
      roughness: 0.86,
      metalness: 0.04
    });
    const stuccoMat = new THREE.MeshStandardMaterial({
      map: createGridTexture('#b7a27a', '#6f6045', 4),
      roughness: 0.9,
      metalness: 0.03
    });
    const asphaltMat = new THREE.MeshStandardMaterial({
      map: createGridTexture('#161b22', '#39404c', 12),
      roughness: 0.94,
      metalness: 0.05
    });
    const cityConcreteMat = new THREE.MeshStandardMaterial({
      map: createGridTexture('#374151', '#1f2937', 7),
      roughness: 0.88,
      metalness: 0.12
    });
    const carBlueMat = new THREE.MeshStandardMaterial({
      map: createGridTexture('#1e3a8a', '#111827', 1),
      roughness: 0.38,
      metalness: 0.62
    });
    const carRedMat = new THREE.MeshStandardMaterial({
      map: createGridTexture('#7f1d1d', '#111827', 1),
      roughness: 0.38,
      metalness: 0.62
    });
    const carYellowMat = new THREE.MeshStandardMaterial({
      map: createGridTexture('#92400e', '#111827', 1),
      roughness: 0.38,
      metalness: 0.62
    });
    const catwalkMat = new THREE.MeshStandardMaterial({
      map: createGridTexture('#64748b', '#94a3b8', 4),
      roughness: 0.45,
      metalness: 0.65
    });

    // Collision AABBs & Walkable Ramps
    const teamGroupPlans = {
      ALPHA: { nodeIndex: -1, timer: 0 },
      BRAVO: { nodeIndex: -1, timer: 0 }
    };

    const mapColliders = []; // { minX, maxX, minY, maxY, minZ, maxZ, isFloorPlatform?: boolean }
    const destructibleProps = []; // { id, mesh, collider, radar, hp, maxHp, destroyed }
    let destructiblePropId = 1;
    const THROW_GRAVITY = 13.5;
    const GRENADE_LAUNCH_SPEED = 15.2;
    const SMOKE_LAUNCH_SPEED = 15.5;
    // Grenade & smoke systems share this queue. Projectiles remain lightweight physics objects.
    const activeProjectiles = [];
    const activeSmokes = [];
    const activeDebris = [];
    const mapRamps = [];     // { minX, maxX, minZ, maxZ, yStart, yEnd, axis: 'x'|'z' }
    const radarWalls = [];   // 2D rects for radar rendering
    let currentMapId = null;
    let arenaLimit = 48.2;   // playable boundary used by resolveCylinderCollision
    let radarHalfExtent = 52;
    let zoneMode = 'COMPOUND';

    const mapGroup = new THREE.Group();
    scene.add(mapGroup);

    function addGround(size) {
      const groundMesh = new THREE.Mesh(new THREE.BoxGeometry(size, 1, size), groundMat);
      groundMesh.position.set(0, -0.5, 0);
      groundMesh.receiveShadow = true;
      mapGroup.add(groundMesh);
    }

    function addBoxObstacle(x, y, z, w, h, d, mat = wallMat, options = {}) {
      const mesh = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat);
      mesh.position.set(x, y, z);
      mesh.castShadow = true;
      mesh.receiveShadow = true;
      mapGroup.add(mesh);

      const box = {
        minX: x - w / 2,
        maxX: x + w / 2,
        minY: y - h / 2,
        maxY: y + h / 2,
        minZ: z - d / 2,
        maxZ: z + d / 2,
        isPlatform: Boolean(options.isPlatform)
      };
      mapColliders.push(box);
      if (!options.hideOnRadar) {
        const radarEntry = { x: box.minX, z: box.minZ, w, d, isPlatform: box.isPlatform };
        box.radar = radarEntry;
        radarWalls.push(radarEntry);
      }

      if (options.destructible) {
        mesh.material = mat.clone ? mat.clone() : mat;
        const prop = {
          id: destructiblePropId++,
          mesh,
          collider: box,
          radar: box.radar || null,
          hp: options.hp || 50,
          maxHp: options.hp || 50,
          destroyed: false
        };
        mesh.name = `destructible-${prop.id}`;
        mesh.userData.destructibleId = prop.id;
        destructibleProps.push(prop);
      }
      return box;
    }

    function addRamp(x, z, w, d, height, axis, dirSign) {
      // Visual sloped wedge built via rotated box + side trim
      const length = axis === 'z' ? d : w;
      const angle = Math.atan2(height, length);
      const hyp = Math.hypot(length, height);

      const geo = axis === 'z'
        ? new THREE.BoxGeometry(w, 0.28, hyp)
        : new THREE.BoxGeometry(hyp, 0.28, d);
      const mesh = new THREE.Mesh(geo, catwalkMat);
      mesh.position.set(x, height / 2 - 0.1, z);
      if (axis === 'z') {
        mesh.rotation.x = dirSign > 0 ? -angle : angle;
      } else {
        mesh.rotation.z = dirSign > 0 ? angle : -angle;
      }
      mesh.castShadow = true;
      mesh.receiveShadow = true;
      mapGroup.add(mesh);

      const ramp = {
        minX: x - w / 2,
        maxX: x + w / 2,
        minZ: z - d / 2,
        maxZ: z + d / 2,
        yStart: dirSign > 0 ? 0 : height,
        yEnd: dirSign > 0 ? height : 0,
        axis
      };
      mapRamps.push(ramp);
      radarWalls.push({ x: ramp.minX, z: ramp.minZ, w, d, isRamp: true });
    }

    function buildCompoundMap() {
      addGround(104);
    // --- Perimeter Compound Walls ---
    addBoxObstacle(0, 4, -50, 102, 8, 2, wallMat);
    addBoxObstacle(0, 4, 50, 102, 8, 2, wallMat);
    addBoxObstacle(-50, 4, 0, 2, 8, 102, wallMat);
    addBoxObstacle(50, 4, 0, 2, 8, 102, wallMat);

    // --- ALPHA SPAWN BASE (South: z = +34..+48) ---
