{
  "name": "strikeforce",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run nav:check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "nav:bake": "tsx scripts/bake-nav.ts",
    "nav:check": "tsx scripts/bake-nav.ts --check"
  },
  "dependencies": {
    "@recast-navigation/core": "^0.44.0",
    "@recast-navigation/generators": "^0.44.0",
    "@recast-navigation/three": "^0.44.0",
    "jszip": "3.10.1",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "0.160.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
